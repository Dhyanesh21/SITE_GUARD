# --- Secrets & local env ---
.env
*.env
!.env.example

# --- Python ---
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/
.mypy_cache/

# --- Model weights (large, downloaded/trained separately) ---
weights/*.pt
!weights/.gitkeep

# --- Dataset (you download from Roboflow; never commit) ---
data/*
!data/.gitkeep

# --- Ultralytics / training run artifacts ---
runs/
*.cache

# --- Snapshots written at runtime for violation evidence ---
snapshots/

# --- Synthetic demo videos generated by scripts/ (regeneratable, not source) ---
scripts/_demo_output/

# --- OS / editor cruft ---
.DS_Store
Thumbs.db
.idea/
.vscode/
