# =============================================================================
# .env.example  — copy to .env and fill in.  .env is gitignored (never commit it).
# These are SECRETS and machine-specific values. Everything non-secret and
# structural (thresholds, zones, classes) lives in config/config.yaml instead.
# =============================================================================

# --- Postgres (used from Step 4 onward) -------------------------------------
# When the API runs on the HOST and Postgres runs in Docker Compose, host is
# localhost. When the API itself runs inside Compose, host becomes the service
# name "db" (we'll cover this at packaging time).
POSTGRES_USER=ppe
POSTGRES_PASSWORD=change_me_locally
POSTGRES_DB=ppe_compliance
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# SQLAlchemy connection string. If left blank, app/config.py builds it from the
# five POSTGRES_* values above.
DATABASE_URL=

# --- Slack alerting (used in Step 6) ----------------------------------------
# Create an Incoming Webhook (we'll walk through this in Step 6) and paste it here.
# Leave blank until then; the alerting layer is written to no-op safely if empty.
SLACK_WEBHOOK_URL=

# --- App wiring -------------------------------------------------------------
# Path to the structural YAML config. Overridable so tests can point elsewhere.
PPE_CONFIG_PATH=config/config.yaml
